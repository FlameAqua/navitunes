<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Navitunes" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.Navitunes.Splash" parent="Theme.SplashScreen">
        <!-- Navy background matching the logo/adaptive-icon so the brief system splash flows
             seamlessly into the animated BrandSplash. The icon is transparent on purpose: the
             logo is animated in by BrandSplash, so showing it here too would double it up. -->
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_none</item>
        <item name="postSplashScreenTheme">@style/Theme.Navitunes</item>
    </style>
</resources>
